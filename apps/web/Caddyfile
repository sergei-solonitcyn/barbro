{
	admin off
	persist_config off
}

:8080 {
	root * /srv

	handle /revision {
		respond "{env.APP_REVISION}"
	}

	handle /assets/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx
		}
		file_server
	}

	handle {
		header {
			Cache-Control "no-cache"
		}
		try_files {path} /index.html
		file_server
	}
}
