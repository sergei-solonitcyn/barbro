    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "nestjs-pino": "^5.3.1",
    "openid-client": "6.8.8",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "catalog:",
