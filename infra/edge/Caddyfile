# Edge proxy: the only entry point behind the Cloudflare Tunnel.
# TLS ends at Cloudflare; cloudflared reaches this server over plain HTTP
# on the Compose network.
{
	admin off
	persist_config off
	# On SIGTERM: stop accepting, let in-flight requests finish for up to 15 s.
	# Must stay below stop_grace_period of the edge service in compose.yaml.
	grace_period 15s
}

:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
